# URL publica do site, usada nas meta tags de preview social (og:image, og:url,
# canonical) do index.html. Precisa ser ABSOLUTA e SEM barra no final.
VITE_SITE_URL=https://robsonizaopaidoconsorcio.com.br

# Caminho em que o site e servido. Precisa terminar em "/".
# Dominio proprio serve na raiz. Sem dominio, no GitHub Pages, seria
# /robson-iza-links/ (o repo vira subdiretorio).
VITE_BASE_PATH=/
