# URL publica do site, usada nas meta tags de preview social (og:image, og:url,
# canonical) do index.html. Precisa ser ABSOLUTA e SEM barra no final.
#
# Ao conectar o dominio proprio, troque por:
#   VITE_SITE_URL=https://robsonizaopaidoconsorcio.com.br
VITE_SITE_URL=https://robsonrpd.github.io/robson-iza-links

# Caminho em que o site e servido. No GitHub Pages o repo vira subdiretorio.
# Ao conectar o dominio proprio, troque para: VITE_BASE_PATH=/
VITE_BASE_PATH=/robson-iza-links/
